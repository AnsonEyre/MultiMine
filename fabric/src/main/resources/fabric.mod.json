{
  "schemaVersion": 1,
  "id": "multimine",
  "version": "${version}",
  "name": "MultiMine",
  "description": "You don't have to mine nonstop on a block to finish it off. You can pause, and come back later.",
  "authors": [
    "Sideways-Sky"
  ],
  "license": "All-Rights-Reserved",
  "icon": "assets/multimine/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.sideways_sky.multimine.fabric.MultiMineFabric"
    ]
  },
  "mixins": [
    "multimine.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.1",
    "java": ">=25",
    "fabric-api": "*"
  },
  "contact": {
    "sources": "https://github.com/AnsonEyre/MultiMine",
    "issues": "https://github.com/AnsonEyre/MultiMine/issues"
  }
}
